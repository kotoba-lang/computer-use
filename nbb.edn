;; nbb.edn — classpath for the resident bot CLI (bin/cua_bot_run.cljk).
;; The CLI is invoked as `nbb bin/cua_bot_run.cljk …` from this checkout
;; root; nbb reads this file for :paths. There are no :deps on purpose —
;; every namespace the CLI reaches is portable .cljc in src/ with no
;; third-party dependency, so the CLI runs from a bare checkout.
{:paths ["src" "bin" "resources"]
 :deps {
        ;; Declared HERE and not only in deps.edn: nbb reads nbb.edn and does NOT
        ;; read deps.edn or bb.edn, and the .cljs in this repo are run as
        ;; bare `nbb <file>`. A coordinate they cannot see is not a
        ;; declaration. sha and :paths are COPIED from deps.edn.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}}}
