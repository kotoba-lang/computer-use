{:paths ["src" "resources"]
 ;; Built on langgraph (graph agent loop) which brings langchain
 ;; (ChatModel / tools / Datomic-API store). Both are zero-third-party-dep .cljc.
 ;; Was pinned {:git/tag "v0.2.0" :sha "133740f..."} -- `:sha` (not
 ;; `:git/sha`) is not a real tools.deps git-coord key, so it was silently
 ;; dropped and resolution fell through to just `:git/tag "v0.2.0"`, which
 ;; is langgraph's pre-org-rename commit (still depends on the OLD
 ;; io.github.com-junkawasaki/langchain-clj coordinate, which shadows
 ;; io.github.kotoba-lang/langchain's `langchain.model` namespace on the
 ;; classpath and drops `openai-model` -- every example in this repo
 ;; failed to load with `No such var: model/openai-model` as a result,
 ;; not just new ones). Pinned past langgraph's org-rename
 ;; (kotoba-lang/langgraph#3) to a commit that depends on
 ;; io.github.kotoba-lang/langchain directly; no v0.2.x tag has this yet
 ;; (newest tag v0.2.1 predates the rename), hence :git/sha only.
 :deps {
        ;; kotoba.bytes replaced UTF-8 .getBytes / String. here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes {:git/sha "d5259f35ab7c4f5a66e63ca29ed4dcf7ba3f1ac5"}
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io {:git/sha "1b60ca825c1e705bd195f857ca4549133653a9f3"}
        ;; kotoba.json replaced clojure.data.json here (2026-09-24). An explicit
        ;; floor: kotoba.json/read-str and /write-str first exist at 9c11ad1, and
        ;; tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/json {:git/sha "9c11ad189e64907700e8b4eb9b26f40336bffa01"}
        ;; kotoba.pprint replaced clojure.pprint here (2026-09-24): the same
        ;; bytes (cljs.pprint transcribed). An explicit floor; tools.deps takes the
        ;; NEWEST sha it is shown.
        io.github.kotoba-lang/pprint {:git/sha "5c9d4aea71d6caac529fffcf361aba0f87ee485e"}
        ;; kotoba.lang.coll replaced clojure.set here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll carries clojure.set's union/intersection/
        ;; difference/map-invert from 0ffd5f6, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/coll {:git/sha "f74e248f0a07e8ae572885f50fab6bdb39dc24be"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       ;; The repository is kotoba-lang/hil. io.github.<org>/<name> is the coordinate
        ;; tools.deps derives from it, and it is the one spelling all three declarers
        ;; (this repo, cloud-itonami/cloud-itonami-app, etzhayyim/tamaki) now agree on.
        ;; Previously this said io.github.com-junkawasaki/hil while the other two said
        ;; the bare kotoba-lang/hil: three names, one repository, and any closure that
        ;; reached two of them would have carried hil.* twice.
        io.github.kotoba-lang/hil
        {:git/url "https://github.com/kotoba-lang/hil.git"
         :git/sha "75f5b9ed3ed00161f331f868a224d3a71e5db00e"}
        io.github.kotoba-lang/langgraph
        {:git/sha "a332a770a0d2b5193f81b54483bb954fb29ef8d7"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; local checkouts for workspace development (orgs/kotoba-lang/*)
  :dev {:override-deps {io.github.kotoba-lang/langgraph
                        {:git/url "https://github.com/kotoba-lang/langgraph.git"
         :git/sha "577a59a9d5eb3ef90b81342f4673973f481ff7f4"}
                        io.github.kotoba-lang/langchain
                        {:git/url "https://github.com/kotoba-lang/langchain.git"
         :git/sha "51e7b61ec3d55e917d5dc77dac145197cb3340df"}}}
  ;; drive a real desktop with a local/remote model (Ollama Gemma 4 E4B QAT
  ;; by default). `kbb -M:gemma -m vultr-ip-allow 220.146.252.121 32`
  :gemma {:extra-paths ["examples"]
          :extra-deps {org.clojure/data.json {:mvn/version "2.5.0"}}}
  ;; read-only statement examples (sumitclub_meisai); `-M:dev:examples`
  :examples {:extra-paths ["examples"]
             :extra-deps {org.clojure/data.json {:mvn/version "2.5.1"}}}
  ;; clj-kondo, errors fail (matches the 3-actor / kagi-clj convention)
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main"
                     "--lint" "src" "test" "examples"
                     "--fail-level" "error"]}}}
