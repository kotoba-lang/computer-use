{:paths ["src"]
 ;; Built on langgraph-clj (graph agent loop) which brings langchain-clj
 ;; (ChatModel / tools / Datomic-API store). Both are zero-third-party-dep .cljc.
 :deps {io.github.com-junkawasaki/hil
        {:local/root "../hil"}
        io.github.com-junkawasaki/langgraph-clj
        {:git/tag "v0.2.0" :git/sha "133740f"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; local checkouts for workspace development (orgs/com-junkawasaki/*)
  :dev {:override-deps {io.github.com-junkawasaki/langgraph-clj
                        {:local/root "../langgraph"}
                        io.github.com-junkawasaki/langchain-clj
                        {:local/root "../langchain"}}}
  ;; drive a real desktop with a local/remote model (Ollama Gemma 4 E4B QAT
  ;; by default). `clojure -M:gemma -m vultr-ip-allow 220.146.252.121 32`
  :gemma {:extra-paths ["examples"]
          :extra-deps {org.clojure/data.json {:mvn/version "2.5.0"}}}
  ;; read-only statement examples (sumitclub_meisai); `-M:dev:examples`
  :examples {:extra-paths ["examples"]
             :extra-deps {org.clojure/data.json {:mvn/version "2.5.1"}}}
  ;; clj-kondo, errors fail (matches the 3-actor / kagi-clj convention)
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main"
                     "--lint" "src" "test" "examples"
                     "--fail-level" "error"]}}}
